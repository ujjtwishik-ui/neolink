# Скопируйте в .env для локального запуска. НИКОГДА не коммитьте .env.
# Строка подключения Neon (Dashboard -> Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# reCAPTCHA v3 (https://www.google.com/recaptcha/admin). Если пусто — проверка отключена (только для разработки!)
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
# Владелец (админ-панель). Аккаунт создаётся при старте, если задан OWNER_PASSWORD.
OWNER_USERNAME=CEBA
OWNER_PASSWORD=
# Доп. origin'ы для CORS через запятую (веб-версия с того же домена не требует)
CORS_ORIGINS=
PORT=3000
